{
  "name": "@workspace/api-server",
  "version": "2.2.0",
  "description": "TeraBox share-link resolver with a secure Telegram bot interface",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "teleproto": "^1.228.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "4.19.2",
    "typescript": "^5.9.0"
  }
}
