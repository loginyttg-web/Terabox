{
  "name": "terabox-pro-bot",
  "version": "3.0.0",
  "description": "TeraBox Pro Bot — Ultra fast resolver with premium Telegram UI, 60+ domains, Railway ready",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "railway:dev": "npm run dev",
    "railway:build": "npm run build",
    "railway:start": "node dist/index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "terabox",
    "telegram-bot",
    "terabox-downloader",
    "terabox-resolver",
    "railway",
    "nodejs"
  ],
  "dependencies": {
    "dotenv": "^16.4.7",
    "teleproto": "^1.228.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "4.19.2",
    "typescript": "^5.9.0"
  }
}
