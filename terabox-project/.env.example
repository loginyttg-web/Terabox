# =============================================================================
# TeraBox COOKIES
# =============================================================================
# REQUIRED for reliable link resolution. Format: JSON object of cookie
# name -> value. Most important cookie is "ndus" (login session). Best to paste
# ALL TeraBox cookies from your browser (ndus, browserid, TSID, ...).
# Browser me F12 -> Application/Storage -> Cookies -> copy every cookie.
TERABOX_COOKIES_JSON={"ndus":"...","browserid":"...","TSID":"..."}

# Cookie ko aap deploy ke baad bhi Telegram bot se badal sakte ho:
#   /setcookie {"ndus":"...","browserid":"..."}

# =============================================================================
# TELEGRAM BOT (link resolver) — OPTIONAL
# =============================================================================
# BotFather se liya hua token: https://t.me/BotFather -> /newbot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram API credentials (my.telegram.org -> API development tools)
# Inhe sirf UPLOAD ke liye chahiye (raw MTProto file transfer). Link resolve
# karne ke liye zaroori nahi.
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Apna numeric Telegram user ID yahan daalo (bot sirf ise allow karega).
# @userinfobot se apna ID pata karo. Comma-separated list bhi chalta hai.
TELEGRAM_ALLOWED_USER_IDS=123456789

# Bot OWNER ka Telegram user id. Owner ko hamesha access rahega aur wo
# /access /revoke /users commands se baaki users ko access de/le sakta hai.
# Iske bina /access kaam nahi karega.
TELEGRAM_OWNER_ID=your_telegram_id

# DUMP / DESTINATION CHANNEL id (negative, jaise -1001234567890).
# - Har naye user ka /start (user id + name + chat id) yahan aayega.
# - Har resolved content ki copy yahan aayegi.
# - Upload enabled ho to upload ki bhi ek copy yahan jayegi.
# Bot ko is channel me ADMIN banao (Settings -> Administrators -> bot add).
# Channel id nikalne ke liye: channel me @userinfobot forward karo ya /id.
TELEGRAM_DEST_CHANNEL_ID=-1001234567890

# true karo to bot sabko allow karega (public). Default false = sirf allowed users.
TELEGRAM_ALLOW_PUBLIC=false

# =============================================================================
# UPLOAD TO TELEGRAM — OFF BY DEFAULT (free Render plan ke liye recommended nahi)
# =============================================================================
# true karne par bot file ko Telegram par upload karega (TeraBox -> Telegram).
# Iske liye bahut disk aur always-on machine chahiye; free web service sleep
# ho jati hai. Free plan pe ise false hi rakho.
TELEGRAM_UPLOAD_ENABLED=false

# Telegram raw MTProto upload limit (MB). Bot ka max ~2GB hai; isko 2000 se
# niche rakho. Default 1900 = ek single upload me itna hi jayega.
TRANSFER_UPLOAD_LIMIT_MB=1900

# 2GB+ file ko kitne MB ke ZIP parts me todna hai. UPLOAD_LIMIT se chhota rakho.
TRANSFER_SPLIT_PART_MB=1800

# 1GB se bada source file hoga to ZIP split on karo (default true).
TRANSFER_SPLIT_OVERSIZE=true

# Ek chat me ek saath kitne active/queued upload allow karne hain. Default 1.
# Zyada karo to ek hi user ke multiple uploads parallel chalein. (1-20)
TRANSFER_MAX_JOBS_PER_CHAT=1

# Parallel download chunks (1-32). Default: 16. More = faster but risk of IP block.
# Safe range: 8-16. Aggressive: 16-32.
TRANSFER_DOWNLOAD_CHUNKS=16

# =============================================================================
# ADMIN DASHBOARD + LOGS
# =============================================================================
# /admin, /admin/status, /admin/logs, /admin/stream ko lock karne ke liye.
# Kam se kam 16 chars. Isko apni pasand ki secret value do.
ADMIN_API_KEY=change_me_to_a_long_secret

# =============================================================================
# KEEP-ALIVE (free plan sleep se bachne ke liye)
# =============================================================================
# Render free web service ~15 min inactivity par sleep ho jata hai. Sleep ko
# rokne ke liye BEST hai EXTERNAL uptime monitor (UptimeRobot/Cronitor) jo aapke
# Render URL ke /health ko har ~10 min ping kare.
#
# Optionally, app khud bhi in URLs ko ping kar sakti hai (tab jab service
# already awake ho — ye khud sleep hui service ko wake NAHI kar sakta):
# KEEPALIVE_URLS=https://your-app.onrender.com/health
# KEEPALIVE_INTERVAL_SECONDS=600

# =============================================================================
# SERVER
# =============================================================================
PORT=8080
CORS_ORIGIN=*
