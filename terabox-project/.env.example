# =============================================================================
# 🚀 TeraBox Pro Bot — Railway Edition v3.0 — ENV EXAMPLE
# =============================================================================
# Copy this file to .env and fill your values: cp .env.example .env
# For Railway: Add these vars in Railway dashboard → Variables

# =============================================================================
# TeraBox COOKIES — REQUIRED for reliable resolving
# =============================================================================
# JSON object of cookie name -> value. Most important is "ndus" (login session).
# Browser: F12 → Application/Storage → Cookies → copy all (ndus, browserid, TSID...)
# Format: {"ndus":"...","browserid":"...","lang":"en",...}
TERABOX_COOKIES_JSON={"ndus":"...","browserid":"...","TSID":"...","lang":"en"}

# You can also update cookies at runtime via Telegram: /setcookie {"ndus":"..."}

# =============================================================================
# TELEGRAM BOT — REQUIRED for Telegram features
# =============================================================================
# Get token from @BotFather: https://t.me/BotFather → /newbot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# For uploads (MTProto): Get from https://my.telegram.org → API development tools
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Your Telegram user ID (owner). Get from @userinfobot. Comma-separated allowed.
TELEGRAM_ALLOWED_USER_IDS=123456789
TELEGRAM_OWNER_ID=your_telegram_id

# Dump/destination channel (negative ID like -1001234567890)
# - New user /start info goes here
# - Content copy goes here
# Bot must be ADMIN in this channel
TELEGRAM_DEST_CHANNEL_ID=-1001234567890

# true = public bot, false = only allowed users (recommended private)
TELEGRAM_ALLOW_PUBLIC=false

# Polling settings (optional, defaults are good)
TELEGRAM_POLL_TIMEOUT_SECONDS=25
TELEGRAM_REQUEST_TIMEOUT_MS=40000
TELEGRAM_MAX_FILES_PER_REPLY=10

# =============================================================================
# UPLOAD TO TELEGRAM — OPTIONAL (needs disk + always-on host like Railway)
# =============================================================================
# On Railway, uploads work great (persistent disk optional but recommended)
# false = only resolve links, no upload. true = enable TeraBox → Telegram
TELEGRAM_UPLOAD_ENABLED=false

# Upload limits (MB) — Telegram bot limit is ~2GB, keep under 2000
TRANSFER_UPLOAD_LIMIT_MB=1900
TRANSFER_SPLIT_PART_MB=1800
TRANSFER_SPLIT_OVERSIZE=true

# Queue & performance
TRANSFER_MAX_JOBS_PER_CHAT=2
TRANSFER_DOWNLOAD_CHUNKS=16
TRANSFER_QUEUE_CONCURRENCY=1
TRANSFER_MAX_QUEUE=5
TRANSFER_UPLOAD_WORKERS=4
TRANSFER_MAX_JOBS_PER_USER_PER_DAY=30

# Temp dir (Railway: /tmp is fine, or use /app/data for persistent)
TRANSFER_TEMP_DIR=/tmp/terabox-transfers
TRANSFER_DATABASE_PATH=/tmp/terabox-transfers/transfer-jobs.sqlite
ACCESS_DATABASE_PATH=/tmp/terabox-transfers/access.sqlite

# =============================================================================
# ADMIN DASHBOARD — /admin (Basic auth: admin / ADMIN_API_KEY)
# =============================================================================
ADMIN_API_KEY=change_me_to_a_very_long_random_secret_min_32_chars

# =============================================================================
# SERVER — Railway sets PORT automatically, HOST must be 0.0.0.0
# =============================================================================
PORT=8080
HOST=0.0.0.0
CORS_ORIGIN=*
CACHE_TTL_SECONDS=7200
CACHE_MAX_ITEMS=1000
TERABOX_REQUEST_TIMEOUT_MS=25000

# =============================================================================
# KEEP-ALIVE — Optional (Railway doesn't sleep, but good for extra)
# =============================================================================
# Railway services don't sleep, so keep-alive is optional.
# For Render free: use external uptime monitor (UptimeRobot) pinging /health
# KEEPALIVE_URLS=https://your-app.railway.app/health
# KEEPALIVE_INTERVAL_SECONDS=600

# =============================================================================
# RAILWAY SPECIFIC — No need to set manually, Railway provides
# =============================================================================
# RAILWAY_ENVIRONMENT, RAILWAY_PROJECT_ID etc are auto-set by Railway
# PORT is auto-set by Railway
